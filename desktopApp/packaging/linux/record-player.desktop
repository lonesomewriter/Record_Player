[Desktop Entry]
Type=Application
Name=Record Player
Comment=Play the music on your computer
Exec=/opt/record-player/bin/record-player %F
Icon=/opt/record-player/lib/record-player.png
Terminal=false
Categories=AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/mp4;audio/x-m4a;audio/m4a;audio/aac;audio/ogg;audio/x-ogg;audio/x-vorbis+ogg;audio/vorbis;application/ogg;audio/opus;audio/x-opus+ogg;audio/wav;audio/x-wav;audio/vnd.wave;
