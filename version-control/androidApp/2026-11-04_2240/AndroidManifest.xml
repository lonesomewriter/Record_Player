<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No INTERNET permission: the app works fully offline. -->
    <!-- Background playback with lock-screen / notification controls. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the CPU awake while playing with the screen off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Added by Media3 for streaming; we never stream, and Media3 copes without it. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- allowBackup=false: playlists and settings are not copied to cloud backups. -->
    <application
        android:allowBackup="false"
        android:name=".RecordDiscApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:exported="true"
            android:launchMode="singleTop"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with" for audio files from a file manager. Only lists the app; Android never
                 makes it the default unless the user picks "Always". The file manager grants read
                 access to the one file, so no storage permission is needed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
        </activity>

        <!-- Exported so the system's media controls can reach it; PlaybackService only accepts trusted callers. -->
        <service
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            android:name=".playback.PlaybackService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".playback.PlaybackWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/playback_widget_info" />
        </receiver>

        <receiver
            android:name=".playback.PlaybackWidgetActionReceiver"
            android:exported="false" />

        <service
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:name=".export.PlaylistExportService" />
    </application>

</manifest>
