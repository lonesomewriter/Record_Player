# Record Player: environment variables
#
# Copy this file to ".env" in the repo root and fill in the values there.
# ".env" is gitignored. Never commit it, and never put real values in this file.

# ---------------------------------------------------------------------------
# Android release signing (used only by: scripts/build.sh release)
#
# Dev builds don't need any of this; they use Android's automatic debug key.
# A release APK must be signed with your own key, or phones won't install it.
#
# One-time setup: create a keystore OUTSIDE the repo folder, for example:
#   keytool -genkeypair -v -keystore ~/keys/recordplayer-release.jks \
#     -alias recordplayer -keyalg RSA -keysize 4096 -validity 10000
# keytool asks for the passwords and your name. Keep the keystore and its
# passwords backed up somewhere safe: updates to an installed release app
# must be signed with the SAME key.
# ---------------------------------------------------------------------------

# Full path to the keystore file (.jks), e.g. /home/<you>/keys/recordplayer-release.jks
RECORDPLAYER_KEYSTORE_PATH=

# The keystore's password (the "store password" keytool asked for)
RECORDPLAYER_KEYSTORE_PASSWORD=

# The key's alias inside the keystore (the -alias value above, e.g. recordplayer)
RECORDPLAYER_KEY_ALIAS=

# The key's own password (keytool may have let you reuse the store password)
RECORDPLAYER_KEY_PASSWORD=
