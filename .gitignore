# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

#project
/project-notes

# gradle / kotlin build output
.gradle
.kotlin
**/build/
!src/**/build/

# android
local.properties
captures
.externalNativeBuild
.cxx
*.apk
*.aab

# desktop packages (build binaries stay local; only project-builds/logs is tracked)
*.deb
*.rpm
*.msi
*.dmg

# signing keys and credentials (never commit)
*.jks
*.keystore
keystore.properties
*.pem

# ide
.idea
*.iml

# misc
.DS_Store

# local env files
.env*.local
.env
