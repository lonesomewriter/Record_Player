# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

#project
/project-notes
# mockups stay private (project manager, 2026-11-06), including their backups
/project/mockups/
/version-control/project/mockups/
/version-control/project-notes/mockups/

# gradle / kotlin build output
.gradle
.kotlin
**/build/
!src/**/build/

# android
local.properties
captures
.externalNativeBuild
.cxx
*.apk
*.aab

# desktop packages (build binaries stay local; only each build folder's build-summary is tracked)
*.deb
*.rpm
*.msi
*.dmg

# signing keys and credentials (never commit)
*.jks
*.keystore
keystore.properties
*.p12
*.pfx
*.key
*.pem

# ide
.idea
*.iml

# misc
.DS_Store

# local env files
.env*.local
.env
